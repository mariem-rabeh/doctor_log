DATABASE_URL=postgresql+psycopg://doctor_log:doctor_log@localhost:5432/doctor_log
# Si le port 5432 est déjà pris sur ta machine : POSTGRES_PORT=5433 et :5433 dans DATABASE_URL
# POSTGRES_PORT=5433
# Fournisseur LLM : gemini, groq ou fake (sans réseau). Mets ta vraie clé dans .env, JAMAIS ici.
LLM_PROVIDER=gemini
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=3
PROMETHEUS_URL=http://localhost:9090
JAEGER_URL=http://localhost:16686
